# Copy to backend/.env (gitignored) and fill in. Never commit real values.
APP_ENV=dev
# huggingface (local development only) | fake (offline, fixed replies, no token) | bedrock (production)
LLM_PROVIDER=huggingface
# Personal Hugging Face token (read access, Inference Providers). Send only test text.
HF_TOKEN=
HF_MODEL_ID=openai/gpt-oss-20b
HF_BASE_URL=https://router.huggingface.co/v1
# Bedrock (production; also usable locally with your AWS credentials). Default: Claude Haiku 4.5.
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS_REGION=us-east-2
# LLM_MAX_TOKENS=1024
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Where chat turns and feedback are recorded: jsonl (local file, default) | dynamodb | none
# INTERACTIONS_STORE=jsonl
# INTERACTIONS_PATH=.interactions/interactions.jsonl
# INTERACTIONS_TABLE=fh26-chat-interactions
# INTERACTIONS_TTL_DAYS=30
# Spend limits (deployed: 5 and 30). Unset locally = no limit.
# DAILY_BUDGET_USD=5
# RATE_LIMIT_PER_HOUR=30
# Sessions and conversation history: memory (default, local) | dynamodb (deployed)
# SESSIONS_STORE=memory
# Customers for identity verification and the demo login: demo (2 fictional, default) | dynamodb
# CUSTOMER_DIRECTORY=demo
# CUSTOMERS_TABLE=fh26-demo-customers
# Password of every demo customer in the web login (public, see docs/demo.md)
# DEMO_PASSWORD=Nova2026
# Human handoff cases: memory (default, local) | dynamodb (deployed); agent console key
# CASES_STORE=memory
# CASES_TABLE=fh26-handoff-cases
# AGENT_CONSOLE_KEY=Asesor2026
