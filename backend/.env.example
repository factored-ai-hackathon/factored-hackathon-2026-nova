# Copy to backend/.env (gitignored) and fill in. Never commit real values.
APP_ENV=dev
# huggingface (local development only) | bedrock (production)
LLM_PROVIDER=huggingface
# Personal Hugging Face token (read access, Inference Providers). Send only test text.
HF_TOKEN=
HF_MODEL_ID=openai/gpt-oss-20b
HF_BASE_URL=https://router.huggingface.co/v1
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
